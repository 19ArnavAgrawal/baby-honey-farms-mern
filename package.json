{
  "name": "baby-honey-farms-root",
  "version": "1.0.0",
  "description": "Full-Stack MERN E-Commerce Platform for Baby Honey Farms",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
